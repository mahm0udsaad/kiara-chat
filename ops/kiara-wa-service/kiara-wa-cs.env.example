# /var/www/kiara-wa-cs/.env — the second customer-facing number.
# Real tokens are generated on the server and copied into Vercel; never commit them.
HOST=127.0.0.1
PORT=2788
WA_CLIENT_ID=kiara-cs
SESSIONS_DIR=/var/www/kiara-wa-cs/.sessions
MAX_MEDIA_BYTES=20971520
# Vercel: OPENWA_CS_SEND_TOKEN
SEND_TOKEN=
# Vercel: OPENWA_CS_INGEST_TOKEN (must differ from the orders engine's token)
INGEST_TOKEN=
INGEST_URL=https://kiara-chat-eight.vercel.app/api/webhooks/openwa
